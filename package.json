{
  "name": "kumar-sambhav-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint app components lib tests playwright.config.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write app components lib tests *.ts *.json",
    "format:check": "prettier --check app components lib tests *.ts *.json"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "prettier": "3.6.2",
    "sass": "1.105.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  }
}
